{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "description": "Family Finance colour tokens. CSS variables in src/app/globals.css are the runtime source.",
  "semantic": {
    "income": { "$type": "color", "$value": "{color.success}" },
    "expense": { "$type": "color", "$value": "{color.danger}" },
    "transfer": { "$type": "color", "$value": "{color.info}" },
    "draft": { "$type": "color", "$value": "{color.text.muted}" },
    "scheduled": { "$type": "color", "$value": "{color.primary}" },
    "pending": { "$type": "color", "$value": "{color.warning}" },
    "posted": { "$type": "color", "$value": "{color.success}" },
    "cancelled": { "$type": "color", "$value": "{color.danger}" }
  },
  "themes": {
    "sunrise": { "label": "Sunrise Family", "light": { "primary": "#FF5B3D", "secondary": "#69B7F3", "accent": "#ffdead", "background": "#FFF8F0", "surface": "#FFFFFF", "text": "#17233C", "border": "#EADFD5" }, "dark": { "primary": "#FF765F", "secondary": "#72C2FF", "accent": "#F7C766", "background": "#101722", "surface": "#182231", "text": "#F9FAFB", "border": "#344054" } },
    "ocean": { "label": "Ocean Calm", "light": { "primary": "#1677B8", "secondary": "#32B8A6", "accent": "#ffdead", "background": "#F3F9FC", "surface": "#FFFFFF", "text": "#123047", "border": "#D5E5EC" }, "dark": { "primary": "#43A9E6", "secondary": "#54D6C2", "accent": "#F7C75E", "background": "#081923", "surface": "#102733", "text": "#EFFAFF", "border": "#2E4A57" } },
    "forest": { "label": "Forest Home", "light": { "primary": "#2F7D5B", "secondary": "#88A96B", "accent": "#ffdead", "background": "#F6F7F0", "surface": "#FFFFFF", "text": "#20352C", "border": "#DCE2D4" }, "dark": { "primary": "#5FC493", "secondary": "#A6C981", "accent": "#E7B45F", "background": "#101A16", "surface": "#192720", "text": "#F0F7F3", "border": "#354A3E" } },
    "lavender": { "label": "Lavender Dream", "light": { "primary": "#7959C8", "secondary": "#E58EB3", "accent": "#66B8C4", "background": "#F9F7FD", "surface": "#FFFFFF", "text": "#29213E", "border": "#E2DCEF" }, "dark": { "primary": "#A98BEF", "secondary": "#F0A7C7", "accent": "#76D0DA", "background": "#15121E", "surface": "#211C2D", "text": "#F8F5FF", "border": "#433A56" } },
    "midnight": { "label": "Midnight Finance", "light": { "primary": "#334E8C", "secondary": "#008E9B", "accent": "#D6A53A", "background": "#F4F6FA", "surface": "#FFFFFF", "text": "#172033", "border": "#D8DEE9" }, "dark": { "primary": "#6F9EFF", "secondary": "#3DCDD5", "accent": "#E8BD58", "background": "#090E18", "surface": "#111A29", "text": "#F3F6FC", "border": "#2C3950" } }
  }
}
