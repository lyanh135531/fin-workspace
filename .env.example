# ============================================================
#  PostgreSQL — dùng bởi service "db" trong docker-compose
# ============================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_strong_password_here
POSTGRES_DB=fin_workspace

# ============================================================
#  Database URL
#  Docker (docker compose) : host = "db"  (tên service nội bộ)
#  Local dev               : đổi "db" → "localhost" và port 5432 → 15432 (nếu dùng docker db host port)
# ============================================================
DATABASE_URL="postgresql://postgres:your_strong_password_here@db:5432/fin_workspace?schema=public"

APP_TIME_ZONE="Asia/Ho_Chi_Minh"

# Generate: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"
# Canonical URL used by NextAuth. Keep the app domain here; browser-side auth
# requests remain same-origin on portal.felixwise.io.vn, so its host-only
# cookies stay isolated from app.felixwise.io.vn.
NEXTAUTH_URL="http://localhost:15730"
# Production: NEXTAUTH_URL="https://app.felixwise.io.vn"

# Google OAuth Web client. Authorized redirect URIs:
# http://localhost:15730/api/auth/callback/google
# https://app.felixwise.io.vn/api/auth/callback/google
# https://portal.felixwise.io.vn/api/auth/callback/google
GOOGLE_CLIENT_ID="replace-with-google-oauth-client-id"
GOOGLE_CLIENT_SECRET="replace-with-google-oauth-client-secret"

# Comma-separated usernames allowed to access the read-only user portal.
# Access is denied to everyone when this variable is empty or omitted.
PLATFORM_ADMIN_USERNAMES="admin"

# Legal consent rollout. Keep disabled until the production policy content and
# the public operator details below have been reviewed.
LEGAL_CONSENT_ENFORCED="false"
LEGAL_OPERATOR_NAME="Your legal name or organization"
LEGAL_OPERATOR_ADDRESS="Your public contact address"
LEGAL_CONTACT_EMAIL="privacy@example.com"
LEGAL_INFRASTRUCTURE_PROVIDERS="List the actual hosting and infrastructure providers"
LEGAL_DATA_STORAGE_LOCATION="List the actual country or region where data is stored"
LEGAL_DATA_RETENTION_SUMMARY="Describe the reviewed retention periods by data category"

# Optional dedicated worker secret: openssl rand -hex 32
# When omitted, the app derives an internal worker token from NEXTAUTH_SECRET.
# RECURRING_WORKER_SECRET="replace-with-a-random-64-character-hex-secret"
# FINANCIAL_PLAN_WORKER_SECRET="replace-with-a-different-random-64-character-hex-secret"
