# ============================================================
#  PostgreSQL — dùng bởi service "db" trong docker-compose
# ============================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_strong_password_here
POSTGRES_DB=fin_workspace

# ============================================================
#  Database URL
#  Docker (docker compose) : host = "db"  (tên service nội bộ)
#  Local dev               : đổi "db" → "localhost" và port 5432 → 15432 (nếu dùng docker db host port)
# ============================================================
DATABASE_URL="postgresql://postgres:your_strong_password_here@db:5432/fin_workspace?schema=public"

APP_TIME_ZONE="Asia/Ho_Chi_Minh"

# Generate: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"
# Public URL of this deployment. Use the local URL for Docker/local development;
# replace it with the externally reachable URL when deploying behind a domain.
NEXTAUTH_URL="http://localhost:15730"

# Optional dedicated worker secret: openssl rand -hex 32
# When omitted, the app derives an internal worker token from NEXTAUTH_SECRET.
# RECURRING_WORKER_SECRET="replace-with-a-random-64-character-hex-secret"
