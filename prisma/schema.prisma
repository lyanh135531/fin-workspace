generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Status {
  active
  deactive

  @@map("STATUS")
}

enum TransactionType {
  income
  expense
  transfer

  @@map("TRANSACTION_TYPE")
}

enum WorkflowStatus {
  pending
  scheduled
  approved
  rejected

  @@map("WORKFLOW_STATUS")
}

enum CategoryType {
  income
  expense

  @@map("CATEGORY_TYPE")
}

enum JarCode {
  ESSENTIAL
  RESPONSIBILITY
  DEVELOPMENT
  ENJOYMENT
  INVESTMENT
  GIVING

  @@map("JAR_CODE")
}

enum FinancialPlanStatus {
  draft
  active
  completed
  cancelled

  @@map("FINANCIAL_PLAN_STATUS")
}

enum ChangeRequestStatus {
  pending
  approved
  rejected

  @@map("CHANGE_REQUEST_STATUS")
}

enum WorkspaceJoinRequestStatus {
  pending
  approved
  rejected

  @@map("WORKSPACE_JOIN_REQUEST_STATUS")
}

enum OAuthIntentKind {
  link
  replace
  set_password
  complete_profile

  @@map("OAUTH_INTENT_KIND")
}

model Role {
  id      String            @id @default(uuid()) @db.Uuid
  name    String
  code    String            @unique
  members WorkspaceMember[]
  joinRequests WorkspaceJoinRequest[]

  @@map("ROLE")
}

model User {
  id           String            @id @default(uuid()) @db.Uuid
  username     String?           @unique
  passwordHash String?           @map("password_hash")
  profileCompletedAt DateTime?   @default(now()) @map("profile_completed_at") @db.Timestamptz(6)
  status       Status            @default(active)
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime?         @map("deleted_at") @db.Timestamptz(6)
  memberships  WorkspaceMember[]
  auditLogs    AuditLog[]
  joinRequests WorkspaceJoinRequest[] @relation("JoinRequester")
  reviewedJoinRequests WorkspaceJoinRequest[]
  oauthAccounts OAuthAccount[]
  oauthLinkIntents OAuthLinkIntent[]

  @@index([status, deletedAt])
  @@map("USERS")
}

model Workspace {
  id          String            @id @default(uuid()) @db.Uuid
  name        String
  description String?
  status      Status            @default(active)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime?         @map("deleted_at") @db.Timestamptz(6)
  baseCurrency String            @default("VND") @map("base_currency") @db.VarChar(3)
  timeZone     String            @default("Asia/Ho_Chi_Minh") @map("time_zone")

  inviteCode   String            @unique @default(uuid()) @map("invite_code") @db.VarChar(36)
  members     WorkspaceMember[]
  wallets     WorkspaceWallet[]
  categories  Category[]
  auditLogs   AuditLog[]
  joinRequests WorkspaceJoinRequest[]
  recurringTransactions RecurringTransaction[]
  financialPlans FinancialPlan[]
  @@index([status, deletedAt])
  @@map("WORKSPACES")
}

model WorkspaceWallet {
  workspaceId String    @map("workspace_id") @db.Uuid
  walletId    String    @map("wallet_id") @db.Uuid
  sortOrder   Int       @default(0) @map("sort_order")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  wallet      Wallet    @relation(fields: [walletId], references: [id], onDelete: Restrict)

  @@id([workspaceId, walletId])
  @@index([walletId])
  @@index([workspaceId, sortOrder])
  @@map("WORKSPACE_WALLET")
}

model WorkspaceMember {
  id           String        @id @default(uuid()) @db.Uuid
  workspaceId  String        @map("workspace_id") @db.Uuid
  userId       String        @map("user_id") @db.Uuid
  roleId       String        @map("role_id") @db.Uuid
  status       Status        @default(active)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime?     @map("deleted_at") @db.Timestamptz(6)
  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  user         User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  role         Role          @relation(fields: [roleId], references: [id], onDelete: Restrict)
  transactions Transaction[]
  requestedChanges TransactionChangeRequest[] @relation("ChangeRequester")
  reviewedChanges  TransactionChangeRequest[] @relation("ChangeReviewer")
  createdRecurringTransactions RecurringTransaction[]
  createdFinancialPlans FinancialPlan[]

  @@unique([workspaceId, userId])
  @@index([workspaceId, status, deletedAt])
  @@index([userId, status, deletedAt])
  @@map("WORKSPACE_MEMBERS")
}

model Wallet {
  id                      String            @id @default(uuid()) @db.Uuid
  name                    String
  openingBalance          Decimal           @default(0) @map("opening_balance") @db.Decimal(20, 4)
  currentBalance          Decimal           @default(0) @map("current_balance") @db.Decimal(20, 4)
  status                  Status            @default(active)
  description             String?
  createdAt               DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt               DateTime?         @map("deleted_at") @db.Timestamptz(6)
  workspaceLinks          WorkspaceWallet[]
  sourceTransactions      Transaction[]     @relation("TransactionSourceWallet")
  destinationTransactions Transaction[]     @relation("TransactionDestinationWallet")
  sourceRecurringTransactions RecurringTransaction[] @relation("RecurringTransactionSourceWallet")
  destinationRecurringTransactions RecurringTransaction[] @relation("RecurringTransactionDestinationWallet")

  @@index([status, deletedAt])
  @@map("WALLETS")
}

model Category {
  id           String        @id @default(uuid()) @db.Uuid
  workspaceId  String        @map("workspace_id") @db.Uuid
  name         String
  code         String
  color        String        @db.VarChar(7)
  type         CategoryType  @default(expense)
  icon         String?
  parentId     String?       @map("parent_id") @db.Uuid
  jarCode      JarCode?      @map("jar_code")
  sortOrder    Int           @default(0) @map("order")
  status       Status        @default(active)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime?     @map("deleted_at") @db.Timestamptz(6)
  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  parent       Category?     @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children     Category[]    @relation("CategoryHierarchy")
  transactions Transaction[]
  recurringTransactions RecurringTransaction[]

  @@unique([workspaceId, code])
  @@index([workspaceId, status, deletedAt, sortOrder])
  @@index([workspaceId, type, jarCode])
  @@map("CATEGORY")
}

model TransactionChangeRequest {
  id                String              @id @default(uuid()) @db.Uuid
  transactionId     String              @map("transaction_id") @db.Uuid
  requesterMemberId String              @map("requester_member_id") @db.Uuid
  reviewerMemberId  String?             @map("reviewer_member_id") @db.Uuid
  previousData      Json                @map("previous_data")
  proposedData      Json                @map("proposed_data")
  status            ChangeRequestStatus @default(pending)
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  reviewedAt        DateTime?           @map("reviewed_at") @db.Timestamptz(6)
  transaction       Transaction         @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  requester         WorkspaceMember     @relation("ChangeRequester", fields: [requesterMemberId], references: [id], onDelete: Restrict)
  reviewer          WorkspaceMember?    @relation("ChangeReviewer", fields: [reviewerMemberId], references: [id], onDelete: Restrict)

  @@index([transactionId, status])
  @@index([requesterMemberId, status])
  @@map("TRANSACTION_CHANGE_REQUEST")
}

model AuditLog {
  id          String           @id @default(uuid()) @db.Uuid
  workspaceId String           @map("workspace_id") @db.Uuid
  actorUserId String?          @map("actor_user_id") @db.Uuid
  action      String
  entityType  String           @map("entity_type")
  entityId    String?          @map("entity_id") @db.Uuid
  metadata    Json?
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  actor       User?            @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([createdAt])
  @@map("AUDIT_LOG")
}

model OAuthAccount {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  provider          String   @db.VarChar(32)
  providerAccountId String   @map("provider_account_id")
  email             String
  displayName       String?  @map("display_name")
  imageUrl          String?  @map("image_url")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@unique([userId, provider])
  @@index([userId])
  @@map("OAUTH_ACCOUNTS")
}

model OAuthLinkIntent {
  id         String          @id @default(uuid()) @db.Uuid
  userId     String          @map("user_id") @db.Uuid
  kind       OAuthIntentKind
  tokenHash  String          @unique @map("token_hash")
  expiresAt  DateTime        @map("expires_at") @db.Timestamptz(6)
  verifiedAt DateTime?       @map("verified_at") @db.Timestamptz(6)
  consumedAt DateTime?       @map("consumed_at") @db.Timestamptz(6)
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind, expiresAt])
  @@map("OAUTH_LINK_INTENTS")
}

model WorkspaceJoinRequest {
  id String @id @default(uuid()) @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid
  requesterId String @map("requester_id") @db.Uuid
  reviewerId String? @map("reviewer_id") @db.Uuid
  roleId String? @map("role_id") @db.Uuid
  status WorkspaceJoinRequestStatus @default(pending)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  respondedAt DateTime? @map("responded_at") @db.Timestamptz(6)
  workspace Workspace @relation(fields:[workspaceId],references:[id],onDelete:Restrict)
  requester User @relation("JoinRequester",fields:[requesterId],references:[id],onDelete:Restrict)
  reviewer User? @relation(fields:[reviewerId],references:[id],onDelete:SetNull)
  role Role? @relation(fields:[roleId],references:[id],onDelete:Restrict)
  @@index([workspaceId,status])
  @@index([requesterId,status])
  @@map("WORKSPACE_JOIN_REQUEST")
}

model Transaction {
  id             String          @id @default(uuid()) @db.Uuid
  memberId       String          @map("member_id") @db.Uuid
  walletId       String          @map("wallet_id") @db.Uuid
  toWalletId     String?         @map("to_wallet_id") @db.Uuid
  categoryId     String?         @map("category_id") @db.Uuid
  type           TransactionType
  workflowStatus WorkflowStatus  @default(pending) @map("workflow_status")
  amount         Decimal         @db.Decimal(20, 4)
  description    String?
  date           DateTime        @db.Date
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime?       @map("deleted_at") @db.Timestamptz(6)
  recurringTransactionId String? @map("recurring_transaction_id") @db.Uuid
  recurringPeriod String?        @map("recurring_period") @db.VarChar(7)
  jarCode         JarCode?       @map("jar_code")
  member         WorkspaceMember @relation(fields: [memberId], references: [id], onDelete: Restrict)
  wallet         Wallet          @relation("TransactionSourceWallet", fields: [walletId], references: [id], onDelete: Restrict)
  toWallet       Wallet?         @relation("TransactionDestinationWallet", fields: [toWalletId], references: [id], onDelete: Restrict)
  category       Category?       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  changeRequests TransactionChangeRequest[]
  recurringTransaction RecurringTransaction? @relation(fields: [recurringTransactionId], references: [id], onDelete: Restrict)

  @@index([memberId, date])
  @@index([walletId, workflowStatus, date])
  @@index([toWalletId, workflowStatus, date])
  @@index([categoryId, date])
  @@index([jarCode, date])
  @@unique([recurringTransactionId, recurringPeriod])
  @@map("TRANSACTION")
}

model RecurringTransaction {
  id                String          @id @default(uuid()) @db.Uuid
  workspaceId       String          @map("workspace_id") @db.Uuid
  createdByMemberId String          @map("created_by_member_id") @db.Uuid
  walletId          String          @map("wallet_id") @db.Uuid
  toWalletId        String?         @map("to_wallet_id") @db.Uuid
  categoryId        String?         @map("category_id") @db.Uuid
  type              TransactionType
  amount            Decimal         @db.Decimal(20, 4)
  description       String?
  dayOfMonth        Int             @map("day_of_month")
  startDate         DateTime        @map("start_date") @db.Date
  endDate           DateTime?       @map("end_date") @db.Date
  nextExecutionDate DateTime        @map("next_execution_date") @db.Date
  status            Status          @default(active)
  completedAt       DateTime?       @map("completed_at") @db.Timestamptz(6)
  lastError         String?         @map("last_error")
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime?       @map("deleted_at") @db.Timestamptz(6)
  workspace         Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  createdBy         WorkspaceMember @relation(fields: [createdByMemberId], references: [id], onDelete: Restrict)
  wallet            Wallet          @relation("RecurringTransactionSourceWallet", fields: [walletId], references: [id], onDelete: Restrict)
  toWallet          Wallet?         @relation("RecurringTransactionDestinationWallet", fields: [toWalletId], references: [id], onDelete: Restrict)
  category          Category?       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  transactions      Transaction[]

  @@index([workspaceId, status, nextExecutionDate])
  @@index([walletId])
  @@index([toWalletId])
  @@index([categoryId])
  @@map("RECURRING_TRANSACTION")
}

model FinancialPlan {
  id                         String              @id @default(uuid()) @db.Uuid
  workspaceId                String              @map("workspace_id") @db.Uuid
  name                       String
  targetAmount               Decimal             @map("target_amount") @db.Decimal(20, 4)
  existingGoalAmount         Decimal             @default(0) @map("existing_goal_amount") @db.Decimal(20, 4)
  startMonth                 DateTime?           @map("start_month") @db.Date
  targetMonth                DateTime            @map("target_month") @db.Date
  status                     FinancialPlanStatus @default(draft)
  createdByMemberId          String              @map("created_by_member_id") @db.Uuid
  activationWorkspaceBalance Decimal?            @map("activation_workspace_balance") @db.Decimal(20, 4)
  activatedAt                DateTime?           @map("activated_at") @db.Timestamptz(6)
  completedAt                DateTime?           @map("completed_at") @db.Timestamptz(6)
  cancelledAt                DateTime?           @map("cancelled_at") @db.Timestamptz(6)
  createdAt                  DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt                  DateTime?           @map("deleted_at") @db.Timestamptz(6)
  workspace                  Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  createdBy                  WorkspaceMember     @relation(fields: [createdByMemberId], references: [id], onDelete: Restrict)
  allocations                PlanJarAllocation[]
  months                     FinancialPlanMonth[]

  @@index([workspaceId, status, deletedAt])
  @@index([targetMonth])
  @@map("FINANCIAL_PLAN")
}

model PlanJarAllocation {
  id              String        @id @default(uuid()) @db.Uuid
  financialPlanId String        @map("financial_plan_id") @db.Uuid
  jarCode         JarCode       @map("jar_code")
  percentage      Decimal       @db.Decimal(5, 2)
  effectiveMonth  DateTime      @map("effective_month") @db.Date
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  financialPlan   FinancialPlan @relation(fields: [financialPlanId], references: [id], onDelete: Restrict)

  @@unique([financialPlanId, effectiveMonth, jarCode])
  @@index([financialPlanId, effectiveMonth])
  @@map("PLAN_JAR_ALLOCATION")
}

model FinancialPlanMonth {
  id                       String                  @id @default(uuid()) @db.Uuid
  financialPlanId          String                  @map("financial_plan_id") @db.Uuid
  month                    DateTime                @db.Date
  baseRequiredAmount       Decimal                 @map("base_required_amount") @db.Decimal(20, 4)
  adjustedRequiredAmount   Decimal                 @map("adjusted_required_amount") @db.Decimal(20, 4)
  rawGrossBudget           Decimal                 @map("raw_gross_budget") @db.Decimal(20, 4)
  allocatableGrossBudget   Decimal                 @map("allocatable_gross_budget") @db.Decimal(20, 4)
  resourceShortfall        Decimal                 @map("resource_shortfall") @db.Decimal(20, 4)
  closedEligibleExpense    Decimal                 @map("closed_eligible_expense") @db.Decimal(20, 4)
  closedActualGoalAmount   Decimal                 @map("closed_actual_goal_amount") @db.Decimal(20, 4)
  closedAt                 DateTime                @map("closed_at") @db.Timestamptz(6)
  calculatorVersion        String                  @map("calculator_version") @db.VarChar(32)
  createdAt                DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  financialPlan            FinancialPlan           @relation(fields: [financialPlanId], references: [id], onDelete: Restrict)
  jars                     FinancialPlanMonthJar[]

  @@unique([financialPlanId, month])
  @@index([month])
  @@map("FINANCIAL_PLAN_MONTH")
}

model FinancialPlanMonthJar {
  id                       String             @id @default(uuid()) @db.Uuid
  financialPlanMonthId     String             @map("financial_plan_month_id") @db.Uuid
  jarCode                  JarCode            @map("jar_code")
  percentage               Decimal            @db.Decimal(5, 2)
  allocatedAmount          Decimal            @map("allocated_amount") @db.Decimal(20, 4)
  closedActualAmount       Decimal            @map("closed_actual_amount") @db.Decimal(20, 4)
  financialPlanMonth       FinancialPlanMonth @relation(fields: [financialPlanMonthId], references: [id], onDelete: Restrict)

  @@unique([financialPlanMonthId, jarCode])
  @@index([jarCode])
  @@map("FINANCIAL_PLAN_MONTH_JAR")
}
