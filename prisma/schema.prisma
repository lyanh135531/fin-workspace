  craftingFeeAmount    Decimal               @default(0) @map("crafting_fee_amount") @db.Decimal(20, 4)
  totalCostAmount      Decimal               @map("total_cost_amount") @db.Decimal(20, 4)
  remainingCostAmount  Decimal               @map("remaining_cost_amount") @db.Decimal(20, 4)
  shopName             String?               @map("shop_name")
  invoiceOrSerial      String?               @map("invoice_or_serial")
  note                 String?
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt            DateTime?             @map("deleted_at") @db.Timestamptz(6)
  workspace            Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  holding              GoldHolding           @relation(fields: [holdingId], references: [id], onDelete: Restrict)
  createdBy            WorkspaceMember       @relation(fields: [createdByMemberId], references: [id], onDelete: Restrict)
  sourceWallet         Wallet?               @relation("GoldPurchaseSourceWallet", fields: [sourceWalletId], references: [id], onDelete: Restrict)
  ledgerTransaction    Transaction?          @relation("GoldPurchaseTransaction", fields: [ledgerTransactionId], references: [id], onDelete: SetNull)
  specificSaleRecords  GoldSaleRecord[]

  @@index([holdingId, purchaseDate, deletedAt])
  @@index([workspaceId, purchaseDate])
  @@map("GOLD_PURCHASE_LOT")
}

model GoldSaleRecord {
  id                       String           @id @default(uuid()) @db.Uuid
  workspaceId              String           @map("workspace_id") @db.Uuid
  holdingId                String           @map("holding_id") @db.Uuid
  purchaseLotId            String?          @map("purchase_lot_id") @db.Uuid
  createdByMemberId        String           @map("created_by_member_id") @db.Uuid
  costMode                 GoldSellCostMode @default(average_cost) @map("cost_mode")
  destinationWalletId      String           @map("destination_wallet_id") @db.Uuid
  ledgerTransactionId      String?          @unique @map("ledger_transaction_id") @db.Uuid
  saleDate                 DateTime         @map("sale_date") @db.Date
  quantityChi              Decimal          @map("quantity_chi") @db.Decimal(16, 4)
  sellPricePerChi          Decimal          @map("sell_price_per_chi") @db.Decimal(20, 4)
  feeOrDeductionAmount     Decimal          @default(0) @map("fee_or_deduction_amount") @db.Decimal(20, 4)
  grossProceedsAmount      Decimal          @map("gross_proceeds_amount") @db.Decimal(20, 4)
  netProceedsAmount        Decimal          @map("net_proceeds_amount") @db.Decimal(20, 4)
  costBasisAllocatedAmount Decimal          @map("cost_basis_allocated_amount") @db.Decimal(20, 4)
  realizedProfitAmount     Decimal          @map("realized_profit_amount") @db.Decimal(20, 4)
  note                     String?
  createdAt                DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt                DateTime?        @map("deleted_at") @db.Timestamptz(6)
  workspace                Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  holding                  GoldHolding      @relation(fields: [holdingId], references: [id], onDelete: Restrict)
  purchaseLot              GoldPurchaseLot? @relation(fields: [purchaseLotId], references: [id], onDelete: SetNull)
  createdBy                WorkspaceMember  @relation(fields: [createdByMemberId], references: [id], onDelete: Restrict)
  destinationWallet        Wallet           @relation("GoldSaleDestinationWallet", fields: [destinationWalletId], references: [id], onDelete: Restrict)
  ledgerTransaction        Transaction?     @relation("GoldSaleTransaction", fields: [ledgerTransactionId], references: [id], onDelete: SetNull)

  @@index([holdingId, saleDate, deletedAt])
  @@index([workspaceId, saleDate])
  @@map("GOLD_SALE_RECORD")
}

model SavingsDeposit {
  id                       String                    @id @default(uuid()) @db.Uuid
  workspaceId              String                    @map("workspace_id") @db.Uuid
  createdByMemberId        String                    @map("created_by_member_id") @db.Uuid
  name                     String
  bankName                 String                    @map("bank_name")
  accountOrPassbookNumber  String?                   @map("account_or_passbook_number")
  fundingMode              InvestmentFundingMode     @default(from_wallet) @map("funding_mode")
  sourceWalletId           String?                   @map("source_wallet_id") @db.Uuid
  openTransactionId        String?                   @unique @map("open_transaction_id") @db.Uuid
  principalAmount          Decimal                   @map("principal_amount") @db.Decimal(20, 4)
  currentPrincipalAmount   Decimal                   @map("current_principal_amount") @db.Decimal(20, 4)
  annualInterestRate       Decimal                   @map("annual_interest_rate") @db.Decimal(8, 4)
  nonTermInterestRate      Decimal                   @default(0.1) @map("non_term_interest_rate") @db.Decimal(8, 4)
  termMonths               Int                       @map("term_months")
  startDate                DateTime                  @map("start_date") @db.Date
  maturityDate             DateTime                  @map("maturity_date") @db.Date
  interestPayoutMode       SavingsInterestPayoutMode @default(maturity) @map("interest_payout_mode")
  maturityAction           SavingsMaturityAction     @default(settle_to_wallet) @map("maturity_action")
  expectedMaturityInterest Decimal                   @default(0) @map("expected_maturity_interest") @db.Decimal(20, 4)
  totalInterestReceived    Decimal                   @default(0) @map("total_interest_received") @db.Decimal(20, 4)
  status                   SavingsDepositStatus      @default(active)
  settledAt                DateTime?                 @map("settled_at") @db.Timestamptz(6)
  note                     String?
  createdAt                DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt                DateTime?                 @map("deleted_at") @db.Timestamptz(6)
  workspace                Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  createdBy                WorkspaceMember           @relation(fields: [createdByMemberId], references: [id], onDelete: Restrict)
  sourceWallet             Wallet?                   @relation("SavingsDepositSourceWallet", fields: [sourceWalletId], references: [id], onDelete: Restrict)
  openTransaction          Transaction?              @relation("SavingsDepositOpenTransaction", fields: [openTransactionId], references: [id], onDelete: SetNull)
  settlements              SavingsDepositSettlement[]

  @@index([workspaceId, status, deletedAt, maturityDate])
  @@map("SAVINGS_DEPOSIT")
}

model SavingsDepositSettlement {
  id                       String         @id @default(uuid()) @db.Uuid
  workspaceId              String         @map("workspace_id") @db.Uuid
  depositId                String         @map("deposit_id") @db.Uuid
  createdByMemberId        String         @map("created_by_member_id") @db.Uuid
  destinationWalletId      String?        @map("destination_wallet_id") @db.Uuid
  ledgerTransactionId      String?        @unique @map("ledger_transaction_id") @db.Uuid
  settlementDate           DateTime       @map("settlement_date") @db.Date
  settlementType           String         @map("settlement_type") @db.VarChar(32)
  principalWithdrawnAmount Decimal        @map("principal_withdrawn_amount") @db.Decimal(20, 4)
  interestReceivedAmount   Decimal        @map("interest_received_amount") @db.Decimal(20, 4)
  totalReceivedAmount      Decimal        @map("total_received_amount") @db.Decimal(20, 4)
  note                     String?
  createdAt                DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  workspace                Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  deposit                  SavingsDeposit @relation(fields: [depositId], references: [id], onDelete: Restrict)
  createdBy                WorkspaceMember @relation(fields: [createdByMemberId], references: [id], onDelete: Restrict)
  destinationWallet        Wallet?        @relation("SavingsSettlementDestinationWallet", fields: [destinationWalletId], references: [id], onDelete: Restrict)
  ledgerTransaction        Transaction?   @relation("SavingsSettlementTransaction", fields: [ledgerTransactionId], references: [id], onDelete: SetNull)

  @@index([depositId, settlementDate])
  @@index([workspaceId, settlementDate])
  @@map("SAVINGS_DEPOSIT_SETTLEMENT")
}


